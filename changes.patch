 /* Keyframe Animations */
+@keyframes solutionOrbitSpin {
+  to { transform: rotate(360deg); }
+}
+
+@keyframes telemetryPing {
+  0% { opacity: 0.8; transform: scale(0.55); }
+  75%, 100% { opacity: 0; transform: scale(1.55); }
+}
+
+@keyframes solutionSignalTravel {
+  0% { top: 0; opacity: 0; }
+  8% { opacity: 1; }
+  88% { opacity: 1; }
+  100% { top: calc(100% - 42px); opacity: 0; }
+}
+
+@keyframes solutionCardScan {
+  0%, 12% { transform: translateX(0) skewX(-14deg); opacity: 0; }
+  22% { opacity: 0.18; }
+  48%, 100% { transform: translateX(450%) skewX(-14deg); opacity: 0; }
+}
+
+@keyframes solutionStepPulse {
+  0%, 100% { opacity: 0.32; transform: scale(0.92); }
+  50% { opacity: 0.8; transform: scale(1); }
+}
+
+@keyframes supportRadarSweep {
+  to { transform: rotate(360deg); }
+}
+
+@keyframes supportSearchGlow {
+  0%, 100% { transform: scaleX(0.98); opacity: 0.3; }
+  50% { transform: scaleX(1.01); opacity: 0.52; }
+}
+
+@keyframes diagnosticCardIn {
+  from { opacity: 0; transform: translateY(12px) scale(0.97); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes diagnosticScan {
+  0%, 15% { transform: translateY(0); opacity: 0; }
+  25% { opacity: 0.35; }
+  62%, 100% { transform: translateY(390%); opacity: 0; }
+}
+
+@keyframes diagnosticMeterFill {
+  from { transform: scaleX(0); opacity: 0.25; }
+  to { transform: scaleX(1); opacity: 1; }
+}
+
+@keyframes supportResultsIn {
+  from { opacity: 0; transform: translateY(-8px) scale(0.99); filter: blur(4px); }
+  to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
+}
+
+@keyframes supportResultRowIn {
+  from { opacity: 0; transform: translateX(-8px); }
+  to { opacity: 1; transform: translateX(0); }
+}
+
+@keyframes supportResponseBreathe {
+  0%, 100% { opacity: 0.45; transform: scale(0.96); }
+  50% { opacity: 0.8; transform: scale(1.03); }
+}
+
+@keyframes supportModalIn {
+  from { opacity: 0; transform: translateY(18px) scale(0.97); filter: blur(7px); }
+  to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
+}
+
