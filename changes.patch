+        {...props}
+      >
+        {/* Subtle top reflection sheen */}
+        <div className="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent" />
+        {children}
+      </div>
+    );
+  }
+);
