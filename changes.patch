+      children,
+      ...props
+    },
+    ref
+  ) => {
+    const blurMap = {
+      sm: 'backdrop-blur-sm',
+      md: 'backdrop-blur-md',
+      lg: 'backdrop-blur-lg',
+      xl: 'backdrop-blur-xl',
