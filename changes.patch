+      subtle:
+        'bg-slate-950/40 border border-white/5 shadow-md',
+      fresnel:
+        'bg-[#0a1329]/80 border border-cyan-400/30 shadow-[0_0_25px_-5px_rgba(0,218,243,0.2),inset_0_0_15px_-5px_rgba(0,218,243,0.15)]',
+      terminal:
